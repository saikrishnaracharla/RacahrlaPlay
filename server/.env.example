# ── Render / Railway Deployment ───────────────────────────────────────────────
# Copy to server/.env and set correct values before deploying

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://racharlaplay.vercel.app

# Music API (saavn.sumit.co)
SAAVN_API_BASE=https://saavn.sumit.co/api

# MySQL (use Render MySQL add-on or PlanetScale)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=racharlaplay

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars
