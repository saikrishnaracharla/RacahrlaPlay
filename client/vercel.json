{
  "version": 2,
  "rewrites": [
    {
      "source": "/youtube/(.*)",
      "destination": "https://racahrla-play.vercel.app/youtube/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://racahrla-play.vercel.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://racahrla-play.vercel.app/auth/$1"
    },
    {
      "source": "/jio/(.*)",
      "destination": "https://racahrla-play.vercel.app/jio/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}