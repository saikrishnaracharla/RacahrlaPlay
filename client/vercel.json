{
  "version": 2,
  "rewrites": [
    {
      "source": "/saavn/(.*)",
      "destination": "https://saavn.sumit.co/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR-BACKEND.vercel.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://YOUR-BACKEND.vercel.app/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
